# ==============================================================================
# FRONTEND NEXT.JS ENVIRONMENT VARIABLES
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Makaura Beauty"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_CURRENCY_CODE="PKR"

# ==============================================================================
# SUPABASE BACKEND REPLACEMENT (Frontend Auth + Brand Onboarding + Admin)
# Copy this file to .env.local and fill in keys from Supabase Dashboard
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
BANK_DATA_ENCRYPTION_KEY=your_aes_256_gcm_hex_key_32_bytes
