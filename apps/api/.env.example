# ==============================================================================
# API SERVICE ENVIRONMENT VARIABLES
# ==============================================================================
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
APP_NAME="Makaura Beauty API"

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://makaura_user:makaura_secure_dev_password_2026@localhost:5432/makaura_marketplace?schema=public"

# Redis & Queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_9f8e7d6c5b4a
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_1a2b3c4d5e6f
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# Marketplace Financial Settings
DEFAULT_COMMISSION_PERCENT=10.00
SETTLEMENT_HOLD_DAYS=3
