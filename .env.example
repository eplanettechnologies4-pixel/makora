# ==============================================================================
# MAKAURA MULTI-VENDOR BEAUTY MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in the respective directories or copy to root for docker-compose.
# NEVER commit production secrets or real credentials to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PREFIX=api/v1
WEB_PORT=3000
APP_NAME="Makaura Beauty Marketplace"

# ------------------------------------------------------------------------------
# 2. CORS & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & PRISMA)
# ------------------------------------------------------------------------------
POSTGRES_USER=makaura_user
POSTGRES_PASSWORD=makaura_secure_dev_password_2026
POSTGRES_DB=makaura_marketplace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full Prisma database connection string:
DATABASE_URL="postgresql://makaura_user:makaura_secure_dev_password_2026@localhost:5432/makaura_marketplace?schema=public"

# ------------------------------------------------------------------------------
# 4. REDIS & BULLMQ (CACHE & BACKGROUND JOBS)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. JWT & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Bank Data Encryption Key (32-byte hex for AES-256-GCM)
BANK_DATA_ENCRYPTION_KEY=your_aes_256_gcm_hex_key_32_bytes

# Initial Admin Credentials (used only by prisma/seed.ts)
ADMIN_INITIAL_EMAIL=admin@makaura.com
ADMIN_INITIAL_PASSWORD=ChangeMeInProduction2026!
ADMIN_INITIAL_FIRST_NAME=Admin
ADMIN_INITIAL_LAST_NAME=User


# ------------------------------------------------------------------------------
# 6. FILE STORAGE ABSTRACTION (LOCAL / S3 / MINIO)
# ------------------------------------------------------------------------------
# Storage driver: 'local' | 's3' | 'minio'
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads
# S3 / MinIO Configuration (for production VPS or cloud deployment)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=makaura-media
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. MARKETPLACE FINANCIAL & COMMISSION POLICIES
# ------------------------------------------------------------------------------
MARKETPLACE_DEFAULT_COMMISSION_PERCENT=10.00
SETTLEMENT_HOLD_DAYS_AFTER_REMITTANCE=3
CURRENCY_CODE=PKR
CURRENCY_SYMBOL=Rs.

# ------------------------------------------------------------------------------
# 8. FRONTEND (NEXT.JS) PUBLIC VARIABLES
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Makaura Beauty"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."
NEXT_PUBLIC_CURRENCY_CODE="PKR"
